{
  "name": "salman-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Salman Alfariesh's portfolio: React 19 + MDX, prerendered and served from Cloudflare Workers.",
  "homepage": "https://salman-alfariesh.alfarieshsalman.workers.dev",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Salman Alfariesh <salman@alfariesh.ai.id>",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build && vp build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "lint": "vp lint",
    "preview": "vp preview",
    "prepare": "vp config",
    "preview:cf": "vp run build && wrangler dev",
    "deploy": "vp run build && wrangler deploy",
    "deploy:preview": "vp run build && wrangler versions upload",
    "setup:deploy": "node scripts/setup-deploy.ts",
    "og": "node scripts/og.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@paper-design/shaders-react": "^0.0.81",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.149.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
